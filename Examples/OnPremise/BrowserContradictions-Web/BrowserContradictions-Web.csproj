<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Proof of concept for the browser contradictions work. Serves a hash data
    file that carries the gatherer JavaScript and the hashed baseline,
    through the standard 51Degrees web integration, with a prototype browser
    element and a derived property script. Not part of any solution.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BrowserContradictions.Web</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FiftyOne.DeviceDetection" Version="4.5.167" />
    <PackageReference Include="FiftyOne.Pipeline.Web" Version="4.5.119" />
    <PackageReference Include="FiftyOne.Pipeline.DerivedProperty" Version="4.5.119" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <None Update="derived\*.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The lab has its own projects and generated files. -->
  <ItemGroup>
    <Compile Remove="gatherer\lab\**" />
    <Content Remove="gatherer\lab\**" />
    <None Remove="gatherer\lab\**" />
  </ItemGroup>

</Project>

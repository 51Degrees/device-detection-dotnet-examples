{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "PipelineOptions": {
    "Elements": [
      {
        "BuilderName": "DeviceDetectionHashEngineBuilder",
        "BuildParameters": {
          "DataFile": "C:\\bc-data\\out-p2\\TAC-HashV41-p2.hash",
          "CreateTempDataCopy": false,
          "AutoUpdate": false,
          "PerformanceProfile": "MaxPerformance",
          "DataFileSystemWatcher": false,
          "DataUpdateOnStartUp": false,
          "Properties": "DeviceId,BrowserName,BrowserVersion,PlatformName,PlatformVersion,HardwareVendor,IsCrawler,IsHeadless,IsVisible,IsVisibleJavaScript,HasWebDriver,HasWebDriverJavaScript,BrowserTests,BrowserTestsJavaScript"
        }
      },
      {
        "BuilderName": "BrowserTestsElementBuilder"
      },
      {
        "BuilderName": "DerivedPropertyElement",
        "BuildParameters": {
          "ScriptFiles": "C:/bc-build-c/bin/BrowserContradictions-Web/release/derived/*.yaml"
        }
      },
      {
        "BuilderName": "JavaScriptBuilderElement",
        "BuildParameters": {
          "Minify": false,
          "EnableCookies": true
        }
      }
    ],
    "ClientSideEvidenceEnabled": true,
    "UseAsyncScript": true,
    "BuildParameters": {
      "SuppressProcessExceptions": false
    }
  }
}
